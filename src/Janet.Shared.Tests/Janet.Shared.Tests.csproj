<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows because Janet.Wpf is under test too; the coalescing
         tests themselves need no UI and create no Application instance. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <!-- Tests need no public API docs. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The library depends only on the abstractions; the tests need a real container
         to prove that two service types resolve to one instance rather than merely that
         two descriptors were added. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Janet.Coalescing\Janet.Coalescing.csproj" />
    <ProjectReference Include="..\Janet.Wpf\Janet.Wpf.csproj" />
    <ProjectReference Include="..\Janet.Wpf.Testing\Janet.Wpf.Testing.csproj" />
    <ProjectReference Include="..\Janet.Coalescing.Testing\Janet.Coalescing.Testing.csproj" />
    <ProjectReference Include="..\Janet.DependencyInjection\Janet.DependencyInjection.csproj" />
    <ProjectReference Include="..\Janet.DependencyInjection.Fixture\Janet.DependencyInjection.Fixture.csproj" />
  </ItemGroup>

</Project>

