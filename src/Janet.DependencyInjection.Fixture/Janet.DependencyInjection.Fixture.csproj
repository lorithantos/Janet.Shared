<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A separate assembly on purpose. AddDependenciesFromAttributes scans a whole
         assembly, so the only way to pin it is an assembly whose every declaration is
         meant to succeed - the broken ones the unit tests need would be scanned too. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Janet.DependencyInjection\Janet.DependencyInjection.csproj" />
  </ItemGroup>

</Project>
