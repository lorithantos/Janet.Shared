<!-- Layer 3: control and typography styles. Everything references layer 2 by
     DynamicResource so a skin swap restyles the live tree; primitives never
     appear here. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Janet.Wpf.Controls">

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Money and other figures: tabular so columns of numbers align. -->
    <Style x:Key="NumericText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontFamily" Value="{DynamicResource FontNumeric}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="HeroNumberText" TargetType="TextBlock" BasedOn="{StaticResource NumericText}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeHero}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Rail group headers: PLAN / RESULTS. -->
    <Style x:Key="SectionLabelText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        <Setter Property="Margin" Value="12,16,12,4" />
    </Style>

    <!-- The rail's own group header: Overview belongs to no group, and an
         empty header would be dead space, so it collapses itself. -->
    <Style x:Key="RailGroupHeaderText" TargetType="TextBlock"
           BasedOn="{StaticResource SectionLabelText}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Name}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The navigation rail: quiet chrome, accent reserved for the selected
         page's indicator bar. -->
    <Style x:Key="RailListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Indicator" Width="3" CornerRadius="1.5" />
                                    <Border x:Name="Chrome"
                                            Grid.Column="1"
                                            Background="Transparent"
                                            CornerRadius="{DynamicResource RadiusSmall}"
                                            Margin="4,1"
                                            Padding="8,6">
                                        <ContentPresenter />
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Background"
                                                Value="{DynamicResource SurfaceSunkenBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Chrome" Property="Background"
                                                Value="{DynamicResource SurfaceSunkenBrush}" />
                                        <Setter TargetName="Indicator" Property="Background"
                                                Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Result-page view switcher: text headers with the same accent
         indicator the rail uses, rotated horizontal. Chrome-free — the page
         is quiet, the selected view is the one accent. -->
    <Style x:Key="QuietTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="QuietTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Background="Transparent" Padding="2,6,2,0" Margin="0,0,20,0">
                        <StackPanel>
                            <ContentPresenter ContentSource="Header" />
                            <Border x:Name="Indicator"
                                    Height="2.5" CornerRadius="1.25"
                                    Margin="0,5,0,0"
                                    Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Indicator" Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Form controls for the settings editors. -->
    <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <Style x:Key="FormTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FormCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FormSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>

    <Style x:Key="FormErrorText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{DynamicResource WarnFaultBrush}" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- Chrome-free grid for editors and ledgers. Font defaults to editor
         density; the deterministic ledger overrides to numeric/caption
         (DESIGN-UX 6 - density tuned per page). -->
    <Style x:Key="QuietDataGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <!-- A read-only quiet grid at ledger density: numeric face, caption size,
         row selection, virtualized. The deterministic ledger and the Monte
         Carlo percentile table are both this. -->
    <Style x:Key="LedgerDataGrid" TargetType="DataGrid"
           BasedOn="{StaticResource QuietDataGrid}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource FontNumeric}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <!-- Ledgers rebind whole row lists when their page recomputes; keep
             the user's column sort across the swap (needs
             NotifyOnTargetUpdated on the ItemsSource binding). -->
        <Setter Property="controls:GridSortMemory.Remember" Value="True" />
    </Style>

    <!-- The raised card every tile, chart housing, and panel sits on. Padding
         defaults to chart density; tiles override it locally. -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- The one prominent action (Run); everything else stays quiet. One
         template for every variant — the hover surface is the attached
         ButtonChrome.HoverBrush, so a new variant is two setters, not a
         template copy. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="controls:ButtonChrome.HoverBrush"
                Value="{DynamicResource AccentStrongBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{Binding Path=(controls:ButtonChrome.HoverBrush),
                                        RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="controls:ButtonChrome.HoverBrush"
                Value="{DynamicResource SurfaceSunkenBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

</ResourceDictionary>
