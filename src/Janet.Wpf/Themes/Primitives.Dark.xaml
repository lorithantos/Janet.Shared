<!-- Layer 1 (dark): same keys as Primitives.Light.xaml, inverted values.
     The neutral ramp keeps its name-order (0 = page surface, 900 = strongest
     ink) so the semantic layer maps identically over both skins. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Color x:Key="Neutral0">#191817</Color>
    <Color x:Key="Neutral50">#211F1E</Color>
    <Color x:Key="Neutral100">#2A2826</Color>
    <Color x:Key="Neutral200">#3A3733</Color>
    <Color x:Key="Neutral400">#6E6960</Color>
    <Color x:Key="Neutral600">#A29C91</Color>
    <Color x:Key="Neutral800">#DCD8D0</Color>
    <Color x:Key="Neutral900">#F0EDE7</Color>

    <Color x:Key="Accent300">#155D56</Color>
    <Color x:Key="Accent500">#3FA79D</Color>
    <Color x:Key="Accent700">#7BC4BC</Color>

    <Color x:Key="PositiveRaw">#5CAE7F</Color>
    <Color x:Key="NegativeRaw">#D4726C</Color>
    <Color x:Key="WarnRaw">#CFA055</Color>

    <FontFamily x:Key="FontBody">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontNumeric">Segoe UI Variable Display, Segoe UI</FontFamily>

    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">16</sys:Double>
    <sys:Double x:Key="FontSizeTitle">22</sys:Double>
    <sys:Double x:Key="FontSizeHero">40</sys:Double>

    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space6">24</sys:Double>
    <sys:Double x:Key="Space8">32</sys:Double>

    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>

</ResourceDictionary>
