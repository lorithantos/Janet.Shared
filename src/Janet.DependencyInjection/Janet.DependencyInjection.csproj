<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Janet.DependencyInjection</PackageId>
    <Description>
      Declare container registration on the class itself. Attributes mark what to
      register, as what, and with which lifetime; one assembly scan turns them
      into descriptors. A class serving several interfaces resolves to one shared
      instance, a factory owns its product outright, and every declaration that
      cannot be honoured throws during startup rather than on first resolve.
    </Description>
    <PackageTags>dependency-injection;ioc;container;attributes;registration;factory</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- The three Handle* passes are internal because they are the scan's steps,
         not its API; the tests drive them one type at a time, which is the only
         way to pin a throw that AddDependenciesFromAttributes would otherwise
         reach only through whatever else the assembly happens to contain. -->
    <InternalsVisibleTo Include="Janet.Shared.Tests" />
  </ItemGroup>

</Project>
