<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Package identity, shared by every shippable project here. Test projects
       opt out with IsPackable=false. -->
  <PropertyGroup>
    <Version>0.8.0</Version>
    <Authors>Lori Thantos</Authors>
    <Company>Lori Thantos</Company>
    <Copyright>Copyright (c) Lori Thantos</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>wpf;mvvm;desktop;ui</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/lorithantos/Janet.Shared</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lorithantos/Janet.Shared</RepositoryUrl>

    <!-- Ship the XML docs. These libraries carry their reasoning in comments —
         WHY the frame is fixed rather than a debounce, why two counters instead
         of one — and a consumer who cannot see that will reimplement the bug the
         comment exists to prevent. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Reproducible output: the same source produces the same bytes, so a
         package can be verified rather than trusted. -->
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Every packable project picks up its own README next to its csproj. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false' AND Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
